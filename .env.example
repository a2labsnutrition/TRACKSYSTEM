# =====================================================================
# Central de Comando de Meta Ads — variáveis de ambiente
# Copie para .env.local (dev) e configure as mesmas na Vercel (produção).
# Sem Supabase configurado, o app roda em MODO DEMO (dados fictícios).
# =====================================================================

# URL pública do app (usada no snippet do script e na URL do webhook)
NEXT_PUBLIC_APP_URL=https://seu-app.vercel.app
# Fuso padrão de novos workspaces
DEFAULT_TIMEZONE=America/Cuiaba

# ---------- Supabase (Project Settings → API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor! Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Segurança ----------
# Chave de 32 bytes para criptografar tokens no banco: openssl rand -base64 32
ENCRYPTION_KEY=
# Segredo do Vercel Cron (a Vercel envia "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# ---------- Meta (developers.facebook.com → seu app → Configurações → Básico) ----------
# Necessário para "Entrar com Facebook" e para ler a data de expiração do token.
# Com token de Usuário do Sistema colado em Conexões, o app funciona mesmo sem estes dois.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
# Dias de histórico na primeira conexão (máx. ~37 meses pela API)
META_HISTORY_DAYS=90

# ---------- Cakto ----------
# O segredo do webhook é salvo pela tela Conexões (criptografado), não aqui.
CAKTO_API_BASE=https://api.cakto.com.br
# Ajustáveis caso a documentação da API mude:
# CAKTO_TOKEN_PATH=/public_api/token/
# CAKTO_ORDERS_PATH=/public_api/orders/

# ---------- IA (Fase 2: Parecer do Consultor) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---------- Verificador de instalação ----------
# Caminho do Chromium para o modo navegador (opcional; na Vercel usa modo HTML)
# CHROMIUM_PATH=/usr/bin/chromium
